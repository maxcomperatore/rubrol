{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/rubrol/static/index.html"
    },
    {
      "source": "/previews/:path*",
      "destination": "/rubrol/static/previews/:path*"
    },
    {
      "source": "/examples/:path*",
      "destination": "/examples/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/logo.png"
    },
    {
      "source": "/pricing",
      "destination": "/rubrol/static/pricing.html"
    },
    {
      "source": "/studio",
      "destination": "/rubrol/static/studio.html"
    },
    {
      "source": "/articles/:slug",
      "destination": "/rubrol/static/articles/:slug.html"
    },
    {
      "source": "/:path*",
      "destination": "/rubrol/static/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}